{
  "name": "xstools-open",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "changeset-add": "changeset add",
    "changeset-publish": "npm run check-publish && changeset publish",
    "changeset-version": "changeset version",
    "check-mono": "sherif",
    "check-publish": "npm run build && npm run fmt && npm run lint && npm run check-type && npm run test",
    "check-type": "turbo run check-type",
    "clean": "del **/dist **/.build **/.swc **/.malagu **/.turbo **/node_modules !node_modules",
    "commit": "cz",
    "dev": "turbo run dev",
    "fmt": "vp fmt --check",
    "fmt:fix": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp hooks enable",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@xstools-dev/mix": "0.19.2",
    "typescript": "5.8.3",
    "vite-plus": "^0.3.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
